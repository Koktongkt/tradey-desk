# Operational records and credentials must never be published.
/private/
/state/
/public/
/test_artifacts/
/*.jsonl
/*.sqlite*
/*.lock
/KILL_SWITCH
/test_*.py
/.env
/.env.*
*.pem
*.key

# Local build and editor artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
*.log
.DS_Store

# Isolated development checkouts (never a second live deployment).
/.worktrees/

# Archify local provenance contains host-specific absolute paths.
/docs/process-flow/*.delivery.json

# Keep only portable Graphify publication artifacts; exclude local caches and bundles.
/graphify-out/*
!/graphify-out/README.md
!/graphify-out/graph.json
!/graphify-out/graph.html
!/graphify-out/graph-preview.png
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/GRAPH_HEALTH.json
!/graphify-out/EXTRACTION_AUDIT.json
!/graphify-out/SOURCE_SCOPE.json
!/graphify-out/BROWSER_VERIFICATION.json
!/graphify-out/ARTIFACT_MANIFEST.json
