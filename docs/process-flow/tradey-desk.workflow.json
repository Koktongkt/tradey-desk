  "cards": [
    {
      "dot": "cyan",
      "title": "Producer / consumer cadence \u2022 New York time",
      "items": [
        "Premarket: 09:00. Radar: 10:00\u201315:40 at :00 / :20 / :40.",
        "Autotrader: 09:40, then 10:10\u201315:50 at :10 / :30 / :50.",
        "Verified eligible dossiers can be reused within 60 minutes; already-reviewed dossiers are normally skipped. Research qualification is not trade approval."
      ]
    },
    {
      "dot": "rose",
      "title": "Execution controls \u2022 checked-in configuration",
      "items": [
        "Paper only; enabled flag and kill switch checked. $10,000 managed exposure; $500 per position; two orders/day; whole shares only.",
        "Planned stop risk <=$40; IEX spread <=600 bps; limit deviation <=150 bps; quote age <=120 seconds; upcoming earnings blackout: two sessions.",
        "Every required gate is fail-closed. Unknown submission state is reconciled, not blindly resubmitted. Stops bound planned risk, not guaranteed loss."
      ]
    },
    {
      "dot": "violet",
      "title": "Independent decision, not model-selected order fields",
      "items": [
        "Python counts exchange sessions: 1\u20135 short; 6\u201330 swing. Completed Massive bars determine technical levels; fresh IEX ask determines BUY limit.",
        "Both isolated tool-free reviewers receive the same hashed proposal. They cannot change its order fields. The lower rubric score must be >=0.55.",
        "Conviction is uncalibrated, not win probability. Shadow calibration is separate from actual paper fills."
      ]
    },
    {
      "dot": "amber",
      "title": "Code takes precedence over stale documentation",
      "items": [
        "Bridge sends GTC brackets; README says DAY. Configuration uses $40 planned risk; README says $25. Configuration spread cap is 600 bps.",
        "SQLite transactional journals have JSONL compatibility projections. Broker orders and fills remain authoritative.",
        "This is a source-backed workflow snapshot, not an account-status audit. No trading controls or orders were changed."
      ]
    }
  ]
